@baseUrl = http://localhost:5046

### 1) Get products paginata
GET {{baseUrl}}/api/products/1/5?isActive=true
Accept: application/json

### 2) Create user
# Generiamo un'email univoca usando la variabile dinamica $timestamp
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "firstName": "Guido",
  "lastName": "Lavespa",
  "email": "glavespa+{{$timestamp}}@example.com"
}

### 3) Create address

POST {{baseUrl}}/api/addresses
Content-Type: application/json

{
  "userId": "42ba5c17-0945-4f68-bfd9-14a2b828e7c4",
  "street": "Via Roma 1",
  "city": "Catania",
  "state": "CT",
  "postalCode": "95100",
  "country": "IT",
  "label": "Casa",
  "isDefault": true
}



### 4) Create order
# Note: unitPrice is NO LONGER sent by client - it's retrieved server-side from ProductService for security
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "userId": "42ba5c17-0945-4f68-bfd9-14a2b828e7c4",
  "shippingAddressId": "a5d17eee-61b3-4369-b9b5-7cac97ed1e4b",
  "billingAddressId": "a5d17eee-61b3-4369-b9b5-7cac97ed1e4b",
  "items": [
    {
      "productId": "aaeff909-86ec-48d4-8c77-aa2dc831f59a",
      "quantity": 1
    }
  ]
}

> {%
    const b = JSON.parse(response.body || '{}');
    if (b.orderId) client.global.set("orderId", b.orderId);
    else if (b.id) client.global.set("orderId", b.id);
%}

### 5) Update order status
PATCH {{baseUrl}}/api/orders/5e2efb20-4d86-4748-9fe0-86b3604f6e44/status
Content-Type: application/json

{
  "status": "Confirmed"
}

### 6) (Opzionale) Get order by id
GET {{baseUrl}}/api/orders/5e2efb20-4d86-4748-9fe0-86b3604f6e44
Accept: application/json